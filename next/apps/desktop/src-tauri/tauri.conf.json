{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuranCode",
  "version": "0.1.0",
  "identifier": "org.qurancode.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuranCode",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../../LICENSE",
    "category": "Education",
    "shortDescription": "Numerical research over the text of the Quran",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/qurancode-engine"],
    "resources": { "resources/content.db": "content.db" }
  }
}
