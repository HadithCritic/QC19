<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuranCode.Desktop.ViewModels"
             x:Class="QuranCode.Desktop.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,150,110">
        <TextBox Grid.Column="0" Text="{Binding Term}"
                 Watermark="Arabic text, with or without diacritics"
                 FlowDirection="RightToLeft" FontSize="17"
                 Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding WordnessOptions}"
                  SelectedIndex="{Binding WordnessIndex}"
                  HorizontalAlignment="Stretch" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Search"
                Command="{Binding RunCommand}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </Grid>
      <ProgressBar IsIndeterminate="True" Height="3"
                   IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" />
      <TextBlock Text="{Binding Error}" Foreground="IndianRed"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:VerseRow">
          <Grid ColumnDefinitions="64,*,90" Margin="0,4">
            <TextBlock Grid.Column="0" Text="{Binding Reference}"
                       Opacity="0.6" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Text}"
                       FontSize="19" TextWrapping="Wrap"
                       FlowDirection="RightToLeft" />
            <TextBlock Grid.Column="2" Text="{Binding Value}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Opacity="0.6" FontFamily="Consolas" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
