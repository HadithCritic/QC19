<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuranCode.Desktop.ViewModels"
             x:Class="QuranCode.Desktop.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Statistics" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" />
      <TextBlock Text="{Binding Error}" Foreground="IndianRed"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="320,*">
      <StackPanel Grid.Column="0" Margin="0,0,16,0">
        <TextBlock Text="Corpus" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Totals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Statistic">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding Name}" Opacity="0.75" />
                <TextBlock Grid.Column="1" Text="{Binding Value}"
                           FontFamily="Consolas" FontWeight="SemiBold" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <DockPanel Grid.Column="1">
        <TextBlock DockPanel.Dock="Top" Text="Letter frequencies"
                   FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding LetterFrequencies}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Letter" Binding="{Binding Name}" Width="90" />
            <DataGridTextColumn Header="Frequency" Binding="{Binding Value}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
