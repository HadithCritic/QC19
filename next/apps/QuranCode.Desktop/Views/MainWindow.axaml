<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuranCode.Desktop.ViewModels"
        xmlns:views="using:QuranCode.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="QuranCode.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="700"
        Title="QuranCode">

  <Window.Resources>
    <views:FeatureViewSelector x:Key="FeatureViews" />
  </Window.Resources>

  <DockPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" />
    </Border>

    <!-- Sidebar: one row per feature. The shell knows nothing about them
         beyond Title and Description. -->
    <Border DockPanel.Dock="Left" Width="210"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="QuranCode"
                   FontSize="20" FontWeight="SemiBold" Margin="16,18,16,14" />
        <ListBox ItemsSource="{Binding Features}"
                 SelectedItem="{Binding SelectedFeature}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureViewModel">
              <StackPanel Margin="2,6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" FontSize="11"
                           Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content: the selected feature renders itself. -->
    <ContentControl Content="{Binding SelectedFeature}"
                    ContentTemplate="{StaticResource FeatureViews}" />
  </DockPanel>
</Window>
