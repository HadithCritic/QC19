# Build output (csproj OutputPath is ..\Build\Release\)
/C#/Build/
# Belt and braces: catch any output that escapes the source tree.
/Build/
[Oo]bj/

# Tools now built as part of Solution.sln (converted from HintPath to
# ProjectReference), so their binaries no longer need to be tracked.
/C#/Tools/Controls/bin/
/C#/Tools/FontBuilder/bin/
/C#/Tools/MP3Player/bin/
/C#/Tools/WAVMaker/bin/

# NOTE: Tools/{Replace,Touch,Version,Evaluator}/bin/Release/*.exe ARE tracked
# deliberately. Version.bat and Release.bat invoke them directly from those
# paths, and they are not part of Solution.sln, so a fresh clone would have
# no way to produce them.

# Visual Studio user state
*.suo
*.user
*.userprefs
.vs/

# Release archives produced by build.ps1
*.zip

# Rule files the legacy engine writes beside the executable at runtime.
# Canonical copies live in Rules/<word-count-method>/.
/Rules/*.txt
